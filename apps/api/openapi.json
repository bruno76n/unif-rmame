  "paths": {
    "/v1/acciones/admin.cambiar_parametro": {
      "post": {
        "tags": [
          "admin"
        ],
        "description": "Cambia el valor de un parámetro del negocio; deja su historial y su bitácora\n\nPermiso: departamento admin; solo la dueña.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "clave_idempotencia": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "La hace el cliente al apretar el botón y la reusa en cada reintento"
                  },
                  "datos": {
                    "type": "object",
                    "properties": {
                      "clave": {
                        "type": "string",
                        "minLength": 1,
                        "description": "La clave del parámetro: `produccion.lote_atorado_dias`"
                      },
                      "ubicacion_id": {
                        "description": "Para un valor por ubicación",
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "valor": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "string"
                          },
                          {
                            "type": "boolean"
                          }
                        ],
                        "description": "El valor según su tipo; centavos en enteros, la hora como «HH:MM»; vacío solo si lo acepta",
                        "nullable": true
                      }
                    },
                    "required": [
                      "clave",
                      "valor"
                    ],
                    "additionalProperties": false
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "La versión que se leyó"
                  }
                },
                "required": [
                  "clave_idempotencia",
                  "datos",
                  "version"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "resultado": {
                      "type": "object",
                      "properties": {
                        "mensaje": {
                          "type": "string",
                          "description": "El aviso verde que muestra la pantalla"
                        },
                        "version": {
                          "description": "La versión nueva de lo que cambió, si la acción editó algo",
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "mensaje"
                      ],
                      "additionalProperties": false
                    },
                    "avisos": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Mensajes que no bloquean"
                    },
                    "secreto_entregado": {
                      "description": "La respuesta repetida de una acción que entregó un secreto: el secreto ya no viene",
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "ok",
                    "resultado",
                    "avisos"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/v1/acciones/admin.agregar_a_lista": {
      "post": {
