{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["es2024", "dom", "dom.iterable"],
		"jsx": "react-jsx",
		"types": ["node"]
	},
	"include": [
		"packages/interfaz/src/**/*.ts",
