{
	"name": "uniformame",
	"private": true,
	"description": "Unifórmame: el sistema de Uniformes Alameda. Monorepo con la API, las pantallas, la tablet y el paquete compartido.",
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": "26.13.0"
	},
	"scripts": {
		"prepare": "git config core.hooksPath .githooks || true",
		"estilo": "biome check .",
		"tipos": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
		"pruebas": "vitest run",
		"revision:rapida": "node scripts/revision-rapida.ts",
		"revision": "node scripts/revision.ts",
		"docs:revisar": "node scripts/docs-revisar.ts",
		"base:generar": "pnpm --filter @uniformame/api base:generar",
		"base:migrar": "pnpm --filter @uniformame/api base:migrar",
		"local": "pnpm --filter @uniformame/api local",
		"base:sembrar": "pnpm --filter @uniformame/api base:sembrar",
		"api:documentar": "pnpm --filter @uniformame/api api:documentar"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@playwright/test": "1.65.0",
		"@types/node": "26.6.6",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	}
}
