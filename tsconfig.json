{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"types": ["node"]
	},
	"include": [
		"*.ts",
		"scripts/**/*.ts",
		"packages/*/src/**/*.ts",
		"apps/*/*.ts",
		"apps/*/src/**/*.ts",
		"apps/*/scripts/**/*.ts",
		"apps/*/semillas/**/*.ts",
		"pruebas/**/*.ts"
	],
	"exclude": ["packages/interfaz/**", "apps/web/**", "apps/tablet/**", "pruebas/flujos/**", "pruebas/temporada/**"]
}
