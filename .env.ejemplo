# Unifórmame · las variables de entorno, sin valores reales.
# Fase 1 · la lista y qué es cada una: docs/cimientos/INFRAESTRUCTURA.md («Las variables de entorno»).
# Se copia a .env (que nunca entra a git) y se llena en cada máquina. Ningún secreto va en este archivo.

# local, pruebas o produccion
ENTORNO=

# Las direcciones de la web, de la tablet y de la API
DOMINIO_WEB=
DOMINIO_TALLER=
DOMINIO_API=

# La conexión de la app a Postgres, con TLS
BASE_DATOS_URL=
# La conexión del rol dueño, solo para las migraciones
BASE_DATOS_URL_DUENO=

# El proveedor de OpenID y el cliente de Google
GOOGLE_EMISOR=
GOOGLE_CLIENTE_ID=
GOOGLE_CLIENTE_SECRETO=

# La llave que cifra la cookie de la entrada con Google
COOKIE_SECRETO=

# La credencial del cubo de archivos en R2
R2_CUENTA=
R2_ARCHIVOS_LLAVE_ID=
R2_ARCHIVOS_SECRETO=

# La credencial del cubo de respaldos, solo escribe
R2_RESPALDOS_LLAVE_ID=
R2_RESPALDOS_SECRETO=

# La llave pública de age con que se cifra el respaldo
RESPALDO_LLAVE_PUBLICA=

# La llave de Resend
RESEND_LLAVE=

# Los correos de las dos cuentas que nacen con la siembra de la puesta en marcha
CORREO_DUENA=
CORREO_SOPORTE=
